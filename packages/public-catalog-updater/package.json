{
  "name": "pagopa-interop-public-catalog-updater",
  "version": "1.0.0",
  "private": true,
  "description": "PagoPA Interoperability Public Catalog Updater Job",
  "main": "dist",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:autofix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "start": "tsx -r \"dotenv-flow/config\" ./src/index.ts",
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@aws-sdk/client-cloudfront": "3.922.0",
    "axios": "catalog:",
    "dotenv-flow": "catalog:",
    "pagopa-interop-public-models": "workspace:*",
    "pg": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:",
    "zod-validation-error": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "mkdirp": "catalog:",
    "pagopa-interop-public-eslint-config": "workspace:*",
    "pagopa-interop-public-typescript-config": "workspace:*",
    "prettier": "catalog:",
    "tsc-esm-fix": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}

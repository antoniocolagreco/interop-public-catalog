{
  "name": "pagopa-interop-public-models",
  "version": "1.0.0",
  "private": true,
  "description": "PagoPA Interoperability models",
  "main": "dist",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "lint": "eslint . --ext .ts,.tsx",
    "lint:autofix": "eslint . --ext .ts,.tsx --fix",
    "format:check": "prettier --check src",
    "format:write": "prettier --write src",
    "build": "tsc",
    "check": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "dependencies": {
    "@protobuf-ts/plugin": "2.9.4",
    "@protobuf-ts/protoc": "2.9.4",
    "@protobuf-ts/runtime": "2.9.4",
    "axios": "catalog:",
    "ts-pattern": "catalog:",
    "zod": "catalog:",
    "zod-validation-error": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "mkdirp": "catalog:",
    "pagopa-interop-public-eslint-config": "workspace:*",
    "pagopa-interop-public-typescript-config": "workspace:*",
    "prettier": "catalog:",
    "tsc-esm-fix": "catalog:",
    "typescript": "catalog:"
  }
}
